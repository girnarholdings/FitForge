# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Optional: base URL used to build the magic-link / OAuth redirect (defaults to request origin).
# In the Pages deploy this is the ORIGIN ONLY — the /FitForge segment comes from
# NEXT_PUBLIC_BASE_PATH via withBase(), because Next does not prefix basePath onto metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Local Mode / static export
# ---------------------------------------------------------------------------
# Sub-path the export is served from. EMPTY for `next dev`, for `next build` locally, and for the
# Playwright suite (which mounts out/ at the root — a prefix here 404s every asset). Set to
# '/FitForge' only when building for project Pages. Read by next.config.mjs (basePath +
# assetPrefix) and by lib/utils.ts withBase() for anything Next will not prefix itself.
NEXT_PUBLIC_BASE_PATH=

# Marks the backend-free demo build. All state lives in localStorage via lib/demo/store.ts.
NEXT_PUBLIC_DEMO=1

# ---------------------------------------------------------------------------
# Optional AI endpoint — the app is fully functional without it
# ---------------------------------------------------------------------------
# Deployed URL of workers/coach (Cloudflare Workers AI). When unset — the default, and what CI
# and Pages build with — the Coach answers from the local knowledge base only and the nutrition
# parser stays purely deterministic. Nothing here ever supplies a nutrition or training number;
# see lib/food/assist.ts.
# NEXT_PUBLIC_AI_ENDPOINT=https://fitforge-coach.<your-subdomain>.workers.dev
