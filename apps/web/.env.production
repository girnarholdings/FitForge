# Baked into PRODUCTION builds (next build). These are the same PUBLIC Firebase web-config
# values committed in .github/workflows/ci.yml and pages.yml — a web app's Firebase config is
# public by design; protection is Firestore rules + authorized domains, never secrecy of these.
# Committing them here makes a plain local `npm run build` produce the SAME build CI tests,
# instead of a silently Firebase-less variant whose cloud specs cannot run.
#
# Shell env vars override this file, so CI/deploy workflows remain authoritative.
# NEVER put a private key of any kind in this or any .env file.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCnTHrW2_sHXkkpzKASKD9ud-vxXsSrNLE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fitforge-007.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fitforge-007
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fitforge-007.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=8172039135
NEXT_PUBLIC_FIREBASE_APP_ID=1:8172039135:web:27cb97aa54b0cde59e326a
